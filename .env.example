# ===================== DISCORD =====================
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Canal de voz onde a radio ficara 24/7
VOICE_CHANNEL_ID=

# Canal de texto opcional para mensagens administrativas da radio
TEXT_CHANNEL_ID=

# ===================== ESTACOES =====================
# Estacao carregada automaticamente ao iniciar
DEFAULT_STATION=lofi

# Pasta onde ficam as estacoes (cada subpasta = uma estacao)
STATIONS_PATH=./stations

# ===================== REPRODUCAO =====================
SHUFFLE_ENABLED=true
AVOID_IMMEDIATE_REPEAT=true

# Volume padrao (0.0 a 2.0). 1.0 = volume normal
VOLUME=1.0

# Reconexao automatica em caso de queda da conexao de voz
AUTO_RECONNECT=true

# Opcional: so preencha se quiser forcar um caminho customizado do FFmpeg.
# Na grande maioria dos casos deixe vazio — o bot ja empacota seu proprio
# FFmpeg (via ffmpeg-static) e funciona mesmo em hosts sem FFmpeg instalado,
# como e o caso da Discloud.
FFMPEG_PATH=

# ===================== TROCA PUBLICA DE ESTACAO =====================
# Quando false, somente Administradores podem trocar de estacao
PUBLIC_STATION_SWITCH_ENABLED=false

# Cooldown por usuario (ms) - 300000 = 5 minutos
PUBLIC_STATION_USER_COOLDOWN_MS=300000

# Cooldown global entre trocas feitas por membros comuns (ms) - 60000 = 1 minuto
PUBLIC_STATION_GLOBAL_COOLDOWN_MS=60000

# Cooldown administrativo minimo, apenas para evitar spam acidental (ms)
ADMIN_STATION_COOLDOWN_MS=2000

# Enviar mensagem no TEXT_CHANNEL_ID quando um membro comum trocar a estacao
ANNOUNCE_PUBLIC_STATION_CHANGE=false
