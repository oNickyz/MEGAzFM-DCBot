# MEGAzFM Core - licenca MIT (ver arquivo LICENSE na raiz do repositorio)

# ===================== IDENTIDADE =====================
# Nome exibido pelo bot (embeds, mensagens). Mude apenas aqui.
BOT_NAME=MEGAzFM

# ===================== DISCORD =====================
# Token do bot. NUNCA compartilhe ou commite o valor real.
DISCORD_TOKEN=
# ID da aplicação Discord (Application ID / Client ID).
CLIENT_ID=
# ID do servidor (guild) onde o bot vai operar.
GUILD_ID=
# ID do canal de voz onde a radio deve tocar.
VOICE_CHANNEL_ID=
# (Opcional) ID de um canal de TEXTO tradicional para avisos da radio.
# Nao e o mesmo que o chat associado ao canal de voz.
TEXT_CHANNEL_ID=

# ===================== ESTACOES =====================
# Nome da pasta em ./stations usada como estacao inicial.
DEFAULT_STATION=lofi
# Caminho da pasta de estacoes.
STATIONS_PATH=./stations
# Embaralhar musicas dentro de cada estacao.
SHUFFLE_ENABLED=true
# Evitar repetir a musica tocada imediatamente antes.
AVOID_IMMEDIATE_REPEAT=true
# Volume padrao (0 a 2). 1.0 = volume normal.
VOLUME=1.0
# Tentar reconectar automaticamente se a conexao de voz cair.
AUTO_RECONNECT=true
# (Opcional) caminho para um binario ffmpeg especifico.
# Deixe vazio para usar o ffmpeg-static incluso no projeto.
FFMPEG_PATH=

# ===================== TROCA PUBLICA DE ESTACAO =====================
# Se true, qualquer usuario pode usar /estacao (respeitando os cooldowns).
PUBLIC_STATION_SWITCH_ENABLED=false
# Cooldown por usuario (ms) para troca publica de estacao.
PUBLIC_STATION_USER_COOLDOWN_MS=300000
# Cooldown global (ms) entre trocas publicas de estacao.
PUBLIC_STATION_GLOBAL_COOLDOWN_MS=60000
# Cooldown para administradores (ms) - normalmente bem menor.
ADMIN_STATION_COOLDOWN_MS=2000
# Anunciar no TEXT_CHANNEL_ID quando a estacao for trocada publicamente.
ANNOUNCE_PUBLIC_STATION_CHANGE=false
